# 复制本文件为 .env 后再启动 adss-server 或 adss-agent。
# 如果系统环境变量和 .env 同时存在，系统环境变量优先生效。

# 主服务：adss-server 使用的数据库连接串。
# adss-server 必填。本地开发可以使用 SQLite。
ADSS_DATABASE_URL=sqlite://adss.db?mode=rwc

# 主服务：密码 envelope provider。
# adss-server 必填。本地开发和测试使用 local。
# 生产环境使用 command，对接外部 KMS/HSM 适配器。
ADSS_PASSWORD_ENVELOPE_PROVIDER=local

# 主服务：local envelope key。
# 仅当 ADSS_PASSWORD_ENVELOPE_PROVIDER=local 时必填。
# 不得在生产环境使用该示例值。
ADSS_PASSWORD_ENVELOPE_LOCAL_KEY=local-dev-only-key

# 主服务：外部 envelope 命令。
# 仅当 ADSS_PASSWORD_ENVELOPE_PROVIDER=command 时必填。
# 主服务会以 seal/open 参数调用该命令，并通过 stdin 传入数据。
# ADSS_PASSWORD_ENVELOPE_COMMAND=C:\Program Files\ADSS\adss-envelope-kms.exe

# 主服务：密码 verifier provider。
# adss-server 必填。生产 provider 使用 argon2id。
ADSS_PASSWORD_HASH_PROVIDER=argon2id

# 主服务：普通用户 Bearer token 签名密钥。
# adss-server 必填。生产环境必须替换为高熵密钥。
ADSS_USER_SESSION_KEY=local-user-session-key

# 主服务：普通用户 token 有效期，单位为秒。
# 可选。未配置时默认为 3600。
# ADSS_USER_SESSION_TTL_SECONDS=3600

# 主服务：adss-server 监听地址。
# 可选。未配置时默认为 127.0.0.1:8080。
ADSS_BIND_ADDR=127.0.0.1:8080

# 域内 Agent：中心服务地址。
# adss-agent 可选。未配置时默认为 http://127.0.0.1:8080。
ADSS_SERVER_URL=http://127.0.0.1:8080

# 域内 Agent：本 Agent 绑定的域标识。
# adss-agent 必填。必须匹配中心数据库 domains.id。
ADSS_DOMAIN_ID=domain-a

# 域内 Agent：访问 /api/agent/* 使用的共享密钥。
# adss-agent 必填。真实值应保存在本机 Secret 中。
ADSS_AGENT_KEY=domain-a-agent-key

# 域内 Agent：本地 revision state 文件路径。
# adss-agent 必填。文件保存已应用的目录/凭据 revision。
ADSS_AGENT_STATE_PATH=agent-domain-a-state.json

# 域内 Agent：同步循环间隔，单位为秒。
# 可选。未配置时默认为 60，且必须大于 0。
ADSS_AGENT_INTERVAL_SECONDS=60

# 域内 Agent：dry-run 模式。
# 设置为 1 时只验证协议和本地 state，不写入 AD。
# 设置为 0 时启用真实 LDAP/LDAPS 写入。
ADSS_AGENT_DRY_RUN=1

# 域内 Agent：真实 AD 写入使用的 LDAP 地址。
# 当 ADSS_AGENT_DRY_RUN=0 时必填。
# ldap:// 可用于受保护网络或测试域。
# ldaps:// 适用于域策略或网络暴露要求传输保护的场景。
# ADSS_LDAP_URL=ldap://dc-a.example.com:389

# 域内 Agent：委派服务账号的 LDAP bind DN。
# 当 ADSS_AGENT_DRY_RUN=0 时必填。
# ADSS_LDAP_BIND_DN=CN=adss-agent,OU=Service Accounts,DC=a,DC=example,DC=com

# 域内 Agent：委派服务账号的 LDAP bind password。
# 当 ADSS_AGENT_DRY_RUN=0 时必填。真实值不得提交到仓库。
# ADSS_LDAP_BIND_PASSWORD=replace-with-local-secret

# 域内 Agent：是否接受无效 LDAP TLS 证书。
# 仅对 ldaps:// 生效，只允许测试环境临时使用。
# ADSS_LDAP_ACCEPT_INVALID_CERTS=0
