# 复制本文件为 adss-center 运行目录下的 .env。
# 如果系统环境变量和 .env 同时存在，系统环境变量优先生效。

# 主服务使用的数据库连接串。
# 必填。本地开发可以使用 SQLite。
ADSS_DATABASE_URL=sqlite://adss.db?mode=rwc

# 密码加密密钥。
# 必填。主服务使用内置 XChaCha20-Poly1305 加密密码材料。
# 生产环境必须替换为高熵密钥，并通过受限 .env、系统环境变量或本机 Secret 保护。
ADSS_PASSWORD_ENCRYPTION_KEY=local-dev-only-password-encryption-key

# 密码校验哈希方式。
# 必填。生产使用 argon2id。
ADSS_PASSWORD_HASH_PROVIDER=argon2id

# 普通用户 Bearer token 签名密钥。
# 必填。生产环境必须替换为高熵密钥。
ADSS_USER_SESSION_KEY=local-user-session-key

# 管理入口 Bearer token。
# 必填。管理入口不能复用普通用户 token。
ADSS_MANAGEMENT_TOKEN=local-management-token

# 普通用户 token 有效期，单位为秒。
# 可选。未配置时默认为 3600。
# ADSS_USER_SESSION_TTL_SECONDS=3600

# adss-center 监听地址。
# 可选。未配置时默认为 127.0.0.1:8080。
ADSS_BIND_ADDR=127.0.0.1:8080

# Web 静态文件目录。
# 可选。未配置时优先读取运行目录下的 web；开发仓库中可自动读取 center/web/.output/public。
# ADSS_WEB_ROOT=web
