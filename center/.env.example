# 复制本文件为 adscope-center 运行目录下的 .env。
# 如果系统环境变量和 .env 同时存在，系统环境变量优先生效。

# 服务

# 主服务使用的数据库连接串。
# 必填。本地开发可以使用 SQLite。
DATABASE_URL=sqlite://adscope.db?mode=rwc

# adscope-center 监听地址。
# 可选。未配置时默认为 127.0.0.1:8080。
BIND_ADDR=127.0.0.1:8080

# Web 静态文件目录。
# 可选。未配置时优先读取运行目录下的 web；开发仓库中可自动读取 center/web/.output/public。
# WEB_ROOT=web

# 密码加密密钥。
# 必填。主服务使用内置 XChaCha20-Poly1305 加密密码材料。
# 生产环境必须替换为高熵密钥，并通过受限 .env、系统环境变量或本机 Secret 保护。
PASSWORD_ENCRYPTION_KEY=local-dev-only-password-encryption-key

# 密码校验哈希方式。
# 必填。生产使用 argon2id。
PASSWORD_HASH_PROVIDER=argon2id

# 会话

# 普通用户 Bearer token 签名密钥。
# 必填。生产环境必须替换为高熵密钥。
SESSION_KEY=local-user-session-key

# 普通用户 token 有效期，单位为秒。
# 可选。未配置时默认为 3600。
# SESSION_TTL_SECONDS=3600

# 管理

# 管理入口 Bearer token。
# 必填。管理入口不能复用普通用户 token。
MANAGEMENT_TOKEN=local-management-token

# OIDC

# OIDC 对外签发者地址。
# 必填。生产环境必须使用外部可访问的 HTTPS 根地址，并与反向代理公布的地址一致。
OIDC_ISSUER=https://center.example.com

# 是否允许 Web 客户端使用 HTTP loopback 回调。
# 可选，默认 false。只在本地开发调试时设为 true，生产环境必须保持 false。
OIDC_LOOPBACK_HTTP=false
