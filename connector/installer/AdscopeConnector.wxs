<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Adscope 连接器"
    Manufacturer="Zoranner"
    Version="$(var.ProductVersion)"
    UpgradeCode="7B73A5A3-48D4-481C-B4F8-8F87C4F65B14"
    Language="2052"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 Adscope 连接器。" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="CENTER_URL" Secure="yes" />
    <Property Id="DIRECTORY_DOMAIN_ID" Secure="yes" />
    <Property Id="CONNECTOR_ACCESS_KEY" Secure="yes" Hidden="yes" />
    <Property Id="DOMAIN_CONTROLLER_LDAP_URL" Secure="yes" />
    <Property Id="MATCH_LEGACY_USERS_BY_USERNAME" Value="0" Secure="yes" />

    <Launch
      Condition="CENTER_URL AND DIRECTORY_DOMAIN_ID AND CONNECTOR_ACCESS_KEY AND DOMAIN_CONTROLLER_LDAP_URL"
      Message="请使用 msiexec 并提供 CENTER_URL、DIRECTORY_DOMAIN_ID、CONNECTOR_ACCESS_KEY 和 DOMAIN_CONTROLLER_LDAP_URL 参数。" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ConnectorInstallDirectory" Name="Adscope Connector">
        <Component Id="ConnectorExecutableComponent" Guid="5219B7B0-1B73-45A5-89B0-3E8B6F245011">
          <File Id="ConnectorExecutable" Source="$(var.ConnectorBinary)" KeyPath="yes" />
          <ServiceInstall
            Id="ConnectorService"
            Name="AdscopeConnector"
            DisplayName="Adscope 连接器"
            Description="将中心服务的目录状态同步到 Active Directory。"
            Start="auto"
            Type="ownProcess"
            ErrorControl="normal"
            Account="NT AUTHORITY\NetworkService"
            Arguments="--service --runtime-dir &quot;[ConnectorRuntimeDirectory]&quot;" />
          <ServiceControl
            Id="ConnectorServiceControl"
            Name="AdscopeConnector"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ConnectorRuntimeDirectory" Name="Adscope Connector">
        <Component Id="ConnectorRuntimeDirectoryComponent" Guid="87D083B8-5BEC-4D9C-99AB-36733855CF83">
          <CreateFolder />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ConnectorFeature" Title="Adscope 连接器" Level="1">
      <ComponentRef Id="ConnectorExecutableComponent" />
      <ComponentRef Id="ConnectorRuntimeDirectoryComponent" />
    </Feature>

    <CustomAction
      Id="SetConnectorConfigCommand"
      Property="WriteConnectorConfig"
      Value="--configure --runtime-dir &quot;[ConnectorRuntimeDirectory]&quot; --center-url &quot;[CENTER_URL]&quot; --directory-domain-id &quot;[DIRECTORY_DOMAIN_ID]&quot; --connector-access-key &quot;[CONNECTOR_ACCESS_KEY]&quot; --domain-controller-ldap-url &quot;[DOMAIN_CONTROLLER_LDAP_URL]&quot; --match-legacy-users-by-username &quot;[MATCH_LEGACY_USERS_BY_USERNAME]&quot;" />
    <CustomAction
      Id="WriteConnectorConfig"
      FileRef="ConnectorExecutable"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes" />

    <InstallExecuteSequence>
      <Custom Action="SetConnectorConfigCommand" Before="WriteConnectorConfig">NOT Installed</Custom>
      <Custom Action="WriteConnectorConfig" After="InstallFiles">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Package>
</Wix>
