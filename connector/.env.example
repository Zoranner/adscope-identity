# 复制本文件为 adss-connector 运行目录下的 .env。
# 如果系统环境变量和 .env 同时存在，系统环境变量优先生效。

# 中心服务地址。
# 可选。未配置时默认为 http://127.0.0.1:8080。
ADSS_CENTER_URL=http://127.0.0.1:8080

# 本 Connector 绑定的域标识。
# 必填。必须匹配中心数据库 domains.id。
ADSS_DOMAIN_ID=domain-a

# 访问 /api/connector/* 使用的共享密钥。
# 必填。真实值应保存在本机 Secret 中。
ADSS_CONNECTOR_KEY=domain-a-connector-key

# 同步循环间隔，单位为秒。
# 可选。未配置时默认为 60，且必须大于 0。
ADSS_CONNECTOR_INTERVAL_SECONDS=60

# dry-run 模式。
# 设置为 1 时只验证协议和本地 state，不写入 AD。
# 设置为 0 时启用真实 LDAP/LDAPS 写入。
ADSS_CONNECTOR_DRY_RUN=1

# 真实 AD 写入使用的 LDAP 地址。
# 当 ADSS_CONNECTOR_DRY_RUN=0 时必填。
# ldap:// 可用于受保护网络或测试域。
# ldaps:// 适用于域策略或网络暴露要求传输保护的场景。
# ADSS_LDAP_URL=ldap://dc-a.example.com:389

# 委派服务账号的 LDAP bind DN。
# 当 ADSS_CONNECTOR_DRY_RUN=0 时必填。
# ADSS_LDAP_BIND_DN=CN=adss-connector,OU=Service Accounts,DC=a,DC=example,DC=com

# 委派服务账号的 LDAP bind password。
# 当 ADSS_CONNECTOR_DRY_RUN=0 时必填。真实值不得提交到仓库。
# ADSS_LDAP_BIND_PASSWORD=replace-with-local-secret

# 是否接受无效 LDAP TLS 证书。
# 仅对 ldaps:// 生效，只允许测试环境临时使用。
# ADSS_LDAP_ACCEPT_INVALID_CERTS=0

# 是否允许按 sAMAccountName 接管历史 AD 用户。
# 仅用于迁移期：当按 employee_id_attribute 找不到中心用户时，Connector 会按 username
# 查找唯一且尚未写入工号属性的 AD 用户，并补写中心 employee_id。
# 迁移完成后应保持关闭。
# ADSS_ADOPT_EXISTING_USERS_BY_USERNAME=0
