# 复制本文件为 adscope-connector 运行目录下的 .env。
# 如果系统环境变量和 .env 同时存在，系统环境变量优先生效。

# 中心服务地址。
# 可选。未配置时默认为 http://127.0.0.1:8080。
ADSCOPE_CENTER_URL=http://127.0.0.1:8080

# 本 Connector 绑定的域标识。
# 必填。必须匹配中心数据库 domains.id。
ADSCOPE_DOMAIN_ID=domain-a

# 访问 /api/connector/* 使用的共享密钥。
# 必填。真实值应保存在本机 Secret 中。
ADSCOPE_CONNECTOR_KEY=domain-a-connector-key

# 同步循环间隔，单位为秒。
# 可选。未配置时默认为 60，且必须大于 0。
ADSCOPE_CONNECTOR_INTERVAL_SECONDS=60

# dry-run 模式。
# 设置为 1 时只验证协议和本地 state，不写入 AD。
# 设置为 0 时以 Kerberos GSS-API 启用真实 LDAP 写入。
ADSCOPE_CONNECTOR_DRY_RUN=1

# 真实 AD 写入使用的 LDAP 地址。
# 当 ADSCOPE_CONNECTOR_DRY_RUN=0 时必填。
# 仅接受 ldap://<FQDN>:389，例如下方的域控 FQDN。
# Connector 使用运行服务的主机计算机账号进行 GSS-API 认证，不保存 LDAP 密码。
# ADSCOPE_LDAP_URL=ldap://dc01.rd.kim:389

# 是否允许按 sAMAccountName 接管历史 AD 用户。
# 仅用于迁移期：当按 employee_id_attribute 找不到中心用户时，Connector 会按 username
# 查找唯一且尚未写入工号属性的 AD 用户，并补写中心 employee_id。
# 迁移完成后应保持关闭。
ADSCOPE_ADOPT_EXISTING_USERS_BY_USERNAME=0
