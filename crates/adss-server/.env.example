# 复制本文件为 adss-server 运行目录下的 .env。
# 如果系统环境变量和 .env 同时存在，系统环境变量优先生效。

# 主服务使用的数据库连接串。
# 必填。本地开发可以使用 SQLite。
ADSS_DATABASE_URL=sqlite://adss.db?mode=rwc

# 密码加密方式。
# 必填。没有外部密钥系统时使用 local，由本机配置提供高熵密钥。
# 有 KMS/HSM 或其他外部密钥适配器时可使用 command。
ADSS_PASSWORD_ENVELOPE_PROVIDER=local

# 本机密码加密密钥。
# 仅当 ADSS_PASSWORD_ENVELOPE_PROVIDER=local 时必填。
# 生产环境必须替换为高熵密钥，并通过受限 .env、系统环境变量或本机 Secret 保护。
ADSS_PASSWORD_ENVELOPE_LOCAL_KEY=local-dev-only-key

# 外部密码加密命令。
# 仅当 ADSS_PASSWORD_ENVELOPE_PROVIDER=command 时必填。
# 只有部署了外部密钥适配器时才需要配置。
# 主服务会以 seal/open 参数调用该命令，并通过 stdin 传入数据。
# ADSS_PASSWORD_ENVELOPE_COMMAND=C:\Program Files\ADSS\adss-password-crypto.exe

# 密码校验哈希方式。
# 必填。生产使用 argon2id。
ADSS_PASSWORD_HASH_PROVIDER=argon2id

# 普通用户 Bearer token 签名密钥。
# 必填。生产环境必须替换为高熵密钥。
ADSS_USER_SESSION_KEY=local-user-session-key

# 普通用户 token 有效期，单位为秒。
# 可选。未配置时默认为 3600。
# ADSS_USER_SESSION_TTL_SECONDS=3600

# adss-server 监听地址。
# 可选。未配置时默认为 127.0.0.1:8080。
ADSS_BIND_ADDR=127.0.0.1:8080
