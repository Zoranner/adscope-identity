# 复制本文件为 .env，部署前替换所有占位值。

# 服务
# Center 数据库连接。Docker 部署默认使用数据目录中的 SQLite 文件。
DATABASE_URL=sqlite:///data/adscope.db?mode=rwc

# 密码
# 密码材料加密密钥。生产环境必须使用高熵随机值。
# 生成命令：openssl rand -hex 32
PASSWORD_ENCRYPTION_KEY=<generate-a-high-entropy-secret>
# 密码校验算法。生产环境使用 argon2id。
PASSWORD_HASH_PROVIDER=argon2id

# 会话
# 用户登录会话签名密钥。生产环境必须使用高熵随机值。
# 生成命令：openssl rand -hex 32
SESSION_KEY=<generate-a-high-entropy-secret>

# 管理
# 管理接口访问令牌。不能与普通用户会话密钥复用。
# 生成命令：openssl rand -hex 32
MANAGEMENT_TOKEN=<set-a-private-management-token>

# OIDC
# 对外提供 OIDC 服务的 HTTPS 根地址。
OIDC_ISSUER=https://center.example.com
# 是否允许 HTTP loopback 回调，仅本机开发时可设为 true，生产环境保持 false。
OIDC_LOOPBACK_HTTP=false
