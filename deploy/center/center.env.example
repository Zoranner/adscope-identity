# Copy this file to center.env and replace every placeholder before deployment.
ADSS_PASSWORD_ENCRYPTION_KEY=<generate-a-high-entropy-secret>
ADSS_PASSWORD_HASH_PROVIDER=argon2id
ADSS_USER_SESSION_KEY=<generate-a-high-entropy-secret>
ADSS_MANAGEMENT_TOKEN=<set-a-private-management-token>
ADSS_OIDC_ISSUER=https://center.example.com
ADSS_OIDC_PRIVATE_KEY_FILE=/run/secrets/oidc-private-key.pem
ADSS_OIDC_ALLOW_INSECURE_WEB_LOOPBACK_REDIRECTS=false
