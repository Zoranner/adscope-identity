# Copy this file to center.env and replace every placeholder before deployment.
ADSCOPE_PASSWORD_ENCRYPTION_KEY=<generate-a-high-entropy-secret>
ADSCOPE_PASSWORD_HASH_PROVIDER=argon2id
ADSCOPE_USER_SESSION_KEY=<generate-a-high-entropy-secret>
ADSCOPE_MANAGEMENT_TOKEN=<set-a-private-management-token>
ADSCOPE_OIDC_ISSUER=https://center.example.com
ADSCOPE_OIDC_PRIVATE_KEY_FILE=/run/secrets/oidc-private-key.pem
ADSCOPE_OIDC_ALLOW_INSECURE_WEB_LOOPBACK_REDIRECTS=false
