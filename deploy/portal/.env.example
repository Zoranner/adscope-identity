# 复制本文件为 .env，按当前 Portal 的公开入口修改。

# Core 地址。不配 PORTAL_ACCESS_KEY 时必须是直连地址：同一 Docker 网络用容器名
# （http://adscope-core:8080 或 http://core:8080），跨主机用内网 IP；不能填经过
# CDN 或按 Host 分流的公网域名，否则请求会被边缘节点路由回 Portal 形成回环。
# 配了 PORTAL_ACCESS_KEY 后可以填 Core 的公网 HTTPS 地址，由 key 断言 issuer。
CORE_URL=http://adscope-core:8080

# 本入口访问 Core 的凭据，取值必须等于 Core 的 PORTAL_ACCESS_KEYS 中
# 本入口 PUBLIC_ISSUER 对应的 key。不配置时沿用 Host 判断 issuer。
# 生成命令：openssl rand -hex 32
PORTAL_ACCESS_KEY=<key-for-this-issuer>

# 当前 Portal 的公开 HTTPS origin。同一 origin 的多个副本复用同一个值；
# 不同公开 origin 必须分别配置，并且都要出现在 Core 的 OIDC_ISSUERS 中。
PUBLIC_ISSUER=https://auth-a.example.com

# Portal 固定监听地址。所有 Portal 使用同一个内部端口，由前置代理负责公开入口。
LISTEN_ADDR=0.0.0.0:18086

# 面向受信内网且需要管理面的 Portal 可以开启管理；外网入口应设置 ADMIN_ENABLED=false。
LOGIN_ENABLED=true
ADMIN_ENABLED=true

# Portal 自己终止 TLS 时同时取消下面两行注释，并把证书放进 ./app/certs。
# 两项都不设置时监听 HTTP，TLS 由前置反向代理终止；只设置一项时启动失败。
# TLS_CERT_FILE=/run/certs/tls.crt
# TLS_KEY_FILE=/run/certs/tls.key
