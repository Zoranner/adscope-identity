# 复制本文件为 .env，按当前 Portal 所在网络修改。

# Core 的固定地址。Syncer 和 Portal 都直接访问这个地址。
CORE_URL=https://core.example.com

# 当前 Portal 的公开 HTTPS origin。三个 Portal 不能复用同一个值。
PUBLIC_ISSUER=https://auth-a.example.com

# Portal 固定监听地址。三个 Portal 都使用 18086，由各自前置代理负责对外入口。
LISTEN_ADDR=0.0.0.0:18086

# 区域 A、内网入口 B Portal 保持登录和管理开启；外网 Portal 设置 ADMIN_ENABLED=false。
LOGIN_ENABLED=true
ADMIN_ENABLED=true

# Portal 自己终止 TLS 时同时取消下面两行注释，并把证书放进 ./certs。
# 两项都不设置时监听 HTTP，TLS 由前置反向代理终止；只设置一项时启动失败。
# TLS_CERT_FILE=/run/certs/tls.crt
# TLS_KEY_FILE=/run/certs/tls.key
