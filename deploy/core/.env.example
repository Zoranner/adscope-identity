# 复制本文件为 .env，部署前替换所有占位值。

# 数据库
# Core 只接受 PostgreSQL。Compose 内置数据库的服务名是 postgres。
# 生产环境必须替换示例密码，并与 docker-compose.yml 中的 POSTGRES_PASSWORD 保持一致。
DATABASE_URL=postgres://adscope:adscope@postgres:5432/adscope

# 密码
# 密码材料加密密钥。生产环境必须使用高熵随机值。
# 生成命令：openssl rand -hex 32
PASSWORD_ENCRYPTION_KEY=<generate-a-high-entropy-secret>
# 密码校验算法。生产环境使用 argon2id。
PASSWORD_HASH_PROVIDER=argon2id

# 会话
# 用户登录会话签名密钥。生产环境必须使用高熵随机值。
# 生成命令：openssl rand -hex 32
SESSION_KEY=<generate-a-high-entropy-secret>

# 管理
# 管理接口访问令牌。不能与普通用户会话密钥复用。
# 生成命令：openssl rand -hex 32
MANAGEMENT_TOKEN=<set-a-private-management-token>

# OIDC
# Core 接受的 Portal issuer 白名单，逗号分隔。不要加入 Core 自己的后端地址。
OIDC_ISSUERS=https://auth-a.example.com,https://auth-b.example.com,https://auth-c.example.com
# 每个 Portal 访问 Core 的入口凭据，格式：issuer=key，逗号分隔，必须覆盖上面每个 issuer。
# 生成命令：openssl rand -hex 32（key 至少 32 个字符，各入口不要复用）。
# 设置后 Core 只认 key，不再用 Host 判断 issuer；未设置时保持旧的 Host 判断。
PORTAL_ACCESS_KEYS=https://auth-a.example.com=<key-a>,https://auth-b.example.com=<key-b>,https://auth-c.example.com=<key-c>
# 旧部署过渡期才使用 OIDC_ISSUER；它不能与 OIDC_ISSUERS 同时设置。
# 是否允许 HTTP loopback 回调，仅本机开发时可设为 true，生产环境保持 false。
OIDC_LOOPBACK_HTTP=false
